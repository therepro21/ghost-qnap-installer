{
  "templates": [
    {
      "type": 1,
      "title": "Ghost QNAP Installer (Intel/AMD64)",
      "sub_title": "Ghost 6 + MySQL 8 für Intel/AMD64 und ARM64",
      "description": "Installiert und verwaltet Ghost über einen browserbasierten Einrichtungsassistenten. Öffne nach dem Start Port 2380.",
      "location": "https://github.com/therepro21/ghost-qnap-installer",
      "platform": "linux/amd64",
      "image": "ghcr.io/therepro21/ghost-qnap-manager:latest",
      "env": [{"name": "MODE", "value": "qnap"}],
      "volumes": [
        {"container": "/var/run/docker.sock", "bind": "/var/run/docker.sock"},
        {"container": "/data", "volume": "ghost-qnap-manager-data"}
      ],
      "ports": ["2380:2380/tcp"],
      "restart_policy": "unless-stopped",
      "interactive": false,
      "tty": false
    },
    {
      "type": 1,
      "title": "Ghost QNAP Installer (ARM64)",
      "sub_title": "Ghost 6 + MySQL 8 für 64-Bit-ARM",
      "description": "Installiert und verwaltet Ghost über einen browserbasierten Einrichtungsassistenten. Öffne nach dem Start Port 2380.",
      "location": "https://github.com/therepro21/ghost-qnap-installer",
      "platform": "linux/arm64",
      "image": "ghcr.io/therepro21/ghost-qnap-manager:latest",
      "env": [{"name": "MODE", "value": "qnap"}],
      "volumes": [
        {"container": "/var/run/docker.sock", "bind": "/var/run/docker.sock"},
        {"container": "/data", "volume": "ghost-qnap-manager-data"}
      ],
      "ports": ["2380:2380/tcp"],
      "restart_policy": "unless-stopped",
      "interactive": false,
      "tty": false
    }
  ]
}
